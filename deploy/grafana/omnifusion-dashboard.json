{
  "title": "OmniFusion Gateway",
  "uid": "omnifusion-gw",
  "description": "OmniFusion BYOK AI gateway observability: request rate, latency, TTFT, tokens, upstream failures, guardrails findings. Point Prometheus at the gateway /metrics endpoint (see deploy/prometheus/omnifusion.yml) and import this dashboard.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(omnifusion_requests_total[5m]))", "legendFormat": "{{endpoint}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(omnifusion_requests_total[5m]))", "legendFormat": "HTTP {{status}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p50 / p95 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(omnifusion_request_duration_seconds_bucket[5m])))", "legendFormat": "p50 {{endpoint}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(omnifusion_request_duration_seconds_bucket[5m])))", "legendFormat": "p95 {{endpoint}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Time to first token p50 / p95 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(omnifusion_ttft_seconds_bucket[5m])))", "legendFormat": "p50 {{endpoint}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(omnifusion_ttft_seconds_bucket[5m])))", "legendFormat": "p95 {{endpoint}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token throughput by direction",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (direction) (rate(omnifusion_tokens_total[5m]))", "legendFormat": "{{direction}}" }
      ]
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "Semantic cache hit ratio (5m)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "green", "value": 0.5 } ] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(omnifusion_requests_total{provider=\"cache\"}[5m])) / clamp_min(sum(rate(omnifusion_requests_total[5m])), 1e-9)" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Upstream attempt failures by kind",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "targets": [
        { "refId": "A", "expr": "sum by (provider, kind) (rate(omnifusion_upstream_failures_total[5m]))", "legendFormat": "{{provider}} {{kind}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Guardrails findings (1h increase)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "sum by (kind, rule, action) (increase(omnifusion_guardrails_findings_total[1h]))", "legendFormat": "{{kind}}/{{rule}} ({{action}})" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Gateway process (goroutines / RSS)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "go_goroutines", "legendFormat": "goroutines" },
        { "refId": "B", "expr": "process_resident_memory_bytes", "legendFormat": "RSS" }
      ]
    }
  ]
}
